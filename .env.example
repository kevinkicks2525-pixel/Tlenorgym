# ============================================================
# TLÉNOR GYM — PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# ============================================================
# En local: Dupliquez ce fichier sous le nom .env.local
# En production (Vercel / Netlify / VPS): Renseignez ces variables dans les paramètres du serveur

# ── SUPABASE CONFIGURATION ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── NOTIFICATIONS TELEGRAM BOT ─────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── SÉCURITÉ & PARAMÈTRES DU SITE ──────────────────────────
ADMIN_PASSCODE=your_secret_admin_passcode_here
NEXT_PUBLIC_WHATSAPP_NUMBER=213552089293
NEXT_PUBLIC_SITE_URL=https://tlenorgym.dz

